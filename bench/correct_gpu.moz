// ============================================================
//  correct_gpu.moz — GPU カーネル仕様 (§14 / コアライブラリ §8) の差分テスト
//
//  4 バックエンド (interpreter / C / JS / WASM) で同一出力になることを検証する。
//  実 GPU バックエンドは持たないので、各実装は CPU 同期実行で gpu 関数本体を
//  順に呼び出す (ワークグループサイズ × グリッド × 次元) 形でエミュレートする。
// ============================================================

import "../sample/core.moc" as *;
import "../sample/gpu.moc" as *;
import "./util.moz" as U;

// ─── ベクトル加算 (Ptr<f32>) ───────────────────────────────────────
public gpu(workgroupSize=4) function vecAdd(
    out: Ptr<f32>, a: Ptr<f32>, b: Ptr<f32>, n: u32
): void {
    let i: u32 = gpuGlobalId();
    if (i < n) {
        out[i] = a[i] + b[i];
    }
}

// ─── スカラー乗算 (Ptr<i32>) ──────────────────────────────────────
public gpu(workgroupSize=2) function scaleI32(
    out: Ptr<i32>, in: Ptr<i32>, k: i32, n: u32
): void {
    let i: u32 = gpuGlobalId();
    if (i < n) {
        out[i] = in[i] * k;
    }
}

// ─── プレフィックス和: 順次実行を仮定して shared-memory なし版 ──────
public gpu(workgroupSize=1) function inclusivePrefix(
    out: Ptr<i32>, in: Ptr<i32>, n: u32
): void {
    let i: u32 = gpuGlobalId();
    if (i < n) {
        let acc: i32 = new i32(0);
        let j: u32 = new u32(0);
        while (j < i + new u32(1)) {
            acc = acc + in[j];
            j = j + new u32(1);
        }
        out[i] = acc;
    }
}

public function main(): void {
    if (!gpuIsAvailable()) { return; }

    // ── ① vecAdd: a[i] = 1.0, b[i] = 2.0, out[i] = 3.0 (i=0..7) ──
    {
        const N: u32 = new u32(8);
        const bytes: u64 = new u64(32);
        let aBuf:   GpuBuffer = gpuBufferCreate(bytes);
        let bBuf:   GpuBuffer = gpuBufferCreate(bytes);
        let outBuf: GpuBuffer = gpuBufferCreate(bytes);

        let aPtr: Ptr<f32> = aBuf.mapWriteF32();
        let bPtr: Ptr<f32> = bBuf.mapWriteF32();
        let i: u32 = new u32(0);
        while (i < N) {
            aPtr[i] = new f32(1.0);
            bPtr[i] = new f32(2.0);
            i = i + new u32(1);
        }
        aBuf.unmap();
        bBuf.unmap();

        let args: GpuArgs = new GpuArgs();
        args.pushBuffer(outBuf);
        args.pushBuffer(aBuf);
        args.pushBuffer(bBuf);
        args.pushU32(N);
        gpuDispatch1D(vecAdd, args, new u32(2));   // grid=2 × wgX=4 = 8 thread
        gpuSync();

        let outPtr: Ptr<f32> = outBuf.mapReadF32();
        let k: u32 = new u32(0);
        while (k < N) {
            let v: f32 = outPtr[k];
            let s: f32 = v * new f32(1000.0);
            U.reportInt("vecAdd[k]*1000", s.toI32());
            k = k + new u32(1);
        }
        outBuf.unmap();

        aBuf.free();
        bBuf.free();
        outBuf.free();
    }

    // ── ② scaleI32: out[i] = in[i] * 3 ──
    {
        const N: u32 = new u32(6);
        const bytes: u64 = new u64(24);
        let inBuf:  GpuBuffer = gpuBufferCreate(bytes);
        let outBuf: GpuBuffer = gpuBufferCreate(bytes);

        let inPtr: Ptr<i32> = inBuf.mapWriteI32();
        let i: u32 = new u32(0);
        while (i < N) {
            inPtr[i] = i.toI32() + new i32(1);
            i = i + new u32(1);
        }
        inBuf.unmap();

        let args: GpuArgs = new GpuArgs();
        args.pushBuffer(outBuf);
        args.pushBuffer(inBuf);
        args.pushI32(new i32(3));
        args.pushU32(N);
        gpuDispatch1D(scaleI32, args, new u32(3));   // grid=3 × wgX=2 = 6 thread
        gpuSync();

        let outPtr: Ptr<i32> = outBuf.mapReadI32();
        let k: u32 = new u32(0);
        while (k < N) {
            U.reportInt("scale", outPtr[k]);
            k = k + new u32(1);
        }
        outBuf.unmap();

        inBuf.free();
        outBuf.free();
    }

    // ── ③ inclusivePrefix: out[i] = sum(in[0..i]) ──
    {
        const N: u32 = new u32(5);
        const bytes: u64 = new u64(20);
        let inBuf:  GpuBuffer = gpuBufferCreate(bytes);
        let outBuf: GpuBuffer = gpuBufferCreate(bytes);

        let inPtr: Ptr<i32> = inBuf.mapWriteI32();
        let vals: Array<i32> = new Array<i32>(N);
        vals[new u32(0)] = new i32(1);
        vals[new u32(1)] = new i32(2);
        vals[new u32(2)] = new i32(3);
        vals[new u32(3)] = new i32(4);
        vals[new u32(4)] = new i32(5);
        let i: u32 = new u32(0);
        while (i < N) {
            inPtr[i] = vals[i];
            i = i + new u32(1);
        }
        vals.free();
        inBuf.unmap();

        let args: GpuArgs = new GpuArgs();
        args.pushBuffer(outBuf);
        args.pushBuffer(inBuf);
        args.pushU32(N);
        gpuDispatch1D(inclusivePrefix, args, N);   // grid=N × wgX=1 = N thread
        gpuSync();

        let outPtr: Ptr<i32> = outBuf.mapReadI32();
        let k: u32 = new u32(0);
        while (k < N) {
            U.reportInt("prefix", outPtr[k]);
            k = k + new u32(1);
        }
        outBuf.unmap();

        inBuf.free();
        outBuf.free();
    }
}
