// ============================================================
//  gpu.moc — mozaicScript GPU 拡張ライブラリ（先行実装）
//
//  仕様:
//    - mozaicScript-spec.md       §14   GPU カーネル仕様
//    - mozaicScript-corelib-spec.md §8   GPU バッファ / ディスパッチ API
//    - mozaicScript-gpu-ir-spec.md       GPU IR スキーマ
//
//  本ファイルはコアライブラリ仕様 §8 で定義されるオプション拡張クラスを
//  実装する。`gpu` 関数本体は本ファイルに書かれず、`.moz` 側の通常関数に
//  `gpu` 修飾子を付けて記述する（言語仕様 §14.2）。コンパイラはそれを
//  GPU IR（.gpu.json）に lower し、GPU バックエンドがネイティブ形式
//  (.wgsl / .spv / .cu / .metal …) に変換する。
//
//  使用例（.moz 側）:
//      import "./gpu.moc" as *;
//
//      gpu(workgroupSize=64) function vecAdd(
//          out: Ptr<f32>, a: Ptr<f32>, b: Ptr<f32>, n: u32
//      ): void {
//          let i: u32 = gpuGlobalId();
//          if (i < n) { out[i] = a[i] + b[i]; }
//      }
//
//      public function main(): void {
//          if (!gpuIsAvailable()) { return; }
//          let outBuf: GpuBuffer = gpuBufferCreate(new u64(1024 * 4));
//          let aBuf:   GpuBuffer = gpuBufferCreate(new u64(1024 * 4));
//          let bBuf:   GpuBuffer = gpuBufferCreate(new u64(1024 * 4));
//          let args: GpuArgs = new GpuArgs();
//          args.pushBufferMut(&mut outBuf);   // 書き込み先
//          args.pushBuffer(&aBuf);            // 読み取り
//          args.pushBuffer(&bBuf);            // 読み取り
//          args.pushU32(new u32(1024));
//          gpuDispatch1D(vecAdd, args, new u32(16));   // 16 workgroups × 64 = 1024 threads
//          gpuSync();
//      }
// ============================================================


// ============================================================
//  gpu.moc は core.moc の wrapper 型 (i32/u32/f32/u64/boolean) と Ptr<T> を
//  公開シグネチャに利用する。同一プログラム内で core.moc と一緒にロードされる
//  ことを前提に、ここでも明示的に import する (これにより C バックエンドが
//  プリアンブル重複を避け、JS/interpreter は安定したロード順を得る)。
// ============================================================
import "./core.moc" as *;


// ============================================================
//  § 8.1  GpuBuffer
//    GPU との間でデータを受け渡すためのバッファクラス。
//    Map/Unmap モデルでアクセスする。
// ============================================================
public class GpuBuffer {
    mocp public let handle: _m64;

    // 仕様 §8.1: 直接インスタンス化は禁止。
    // `gpuBufferCreate()` 経由で生成すること。
    // コンストラクタは .moc 専用のシグネチャ (_m64) を取るため
    // .moz からは呼べない（§2 + §6.4）。
    public constructor(h: _m64) {
        this.handle = h;
    }

    // 仕様 §8.1: CPU 書き込みアクセス権を要求する。
    // 戻り値の Ptr<T> は型 T の要素列として扱える。
    // unmap() を呼ぶまで GPU はこのバッファを参照してはならない。
    public mapWrite<T>(): Ptr<T> {
        return new Ptr<T>(__builtin_gpu_buffer_map_write(this.handle));
    }

    // 仕様 §8.1: CPU 読み取りアクセス権を要求する。
    public mapRead<T>(): Ptr<T> {
        return new Ptr<T>(__builtin_gpu_buffer_map_read(this.handle));
    }

    // ── 型特殊化版 (method-level generic を回避するためのヘルパー) ──
    // 現バージョンの interpreter / codegen は method-level generic を未対応
    // のため、頻出する f32/i32/u32 については型固定版を提供する。
    public mapWriteF32(): Ptr<f32> { return new Ptr<f32>(__builtin_gpu_buffer_map_write(this.handle)); }
    public mapReadF32():  Ptr<f32> { return new Ptr<f32>(__builtin_gpu_buffer_map_read(this.handle)); }
    public mapWriteU32(): Ptr<u32> { return new Ptr<u32>(__builtin_gpu_buffer_map_write(this.handle)); }
    public mapReadU32():  Ptr<u32> { return new Ptr<u32>(__builtin_gpu_buffer_map_read(this.handle)); }
    public mapWriteI32(): Ptr<i32> { return new Ptr<i32>(__builtin_gpu_buffer_map_write(this.handle)); }
    public mapReadI32():  Ptr<i32> { return new Ptr<i32>(__builtin_gpu_buffer_map_read(this.handle)); }

    // 仕様 §8.1: CPU アクセス権を放棄して GPU へ所有権を返還する。
    // mapWrite()/mapRead() が呼ばれていない状態で呼ぶことは禁止。
    public unmap(): void {
        __builtin_gpu_buffer_unmap(this.handle);
    }

    // 仕様 §8.1: バッファのバイトサイズ。
    public byteSize(): u64 {
        return new u64(__builtin_gpu_buffer_byte_size(this.handle));
    }

    // 仕様 §8.1: バッファを破棄してメモリを解放する。
    // 自動挿入された drop() 呼び出し時にバッファがマッピング状態であった場合は、
    // 安全のために自動的に unmap() を行ってから解放する (MUST)。
    // 簡略実装: 二重 unmap は intrinsic 側でフラグで吸収するため常に呼ぶ。
    public drop(): void {
        __builtin_gpu_buffer_unmap(this.handle);
        __builtin_gpu_buffer_free(this.handle);
    }
}


// ============================================================
//  § 8.2  GPU グローバル関数（バッファ・能力照会）
// ============================================================

// 指定バイトサイズの GPU バッファを確保する。
public function gpuBufferCreate(byteSize: u64): GpuBuffer {
    return new GpuBuffer(__builtin_gpu_buffer_create(byteSize.bits));
}

// GPU バックエンドが利用可能かどうかを返す。
// FALSE を返す環境では他の GPU 関数を呼んではならない。
public function gpuIsAvailable(): boolean {
    return new boolean(__builtin_gpu_is_available());
}


// ============================================================
//  § 8.3.1  GpuKernel
//    gpu 関数への型付き参照。直接インスタンス化することはできず、
//    コンパイラが gpu 関数宣言ごとにグローバルスコープに同名の
//    GpuKernel 定数を自動生成する。
// ============================================================
public class GpuKernel {
    mocp public let handle: _m64;

    public constructor(h: _m64) {
        this.handle = h;
    }

    // カーネル関数名を返す（デバッグ用）。
    public name(): string {
        return __builtin_gpu_kernel_name(this.handle);
    }

    // 宣言された workgroupSize の X 次元値を返す。
    public workgroupSizeX(): u32 {
        return new u32(__builtin_gpu_kernel_workgroup_size_x(this.handle));
    }

    // Y 次元値（未指定時は 1）。
    public workgroupSizeY(): u32 {
        return new u32(__builtin_gpu_kernel_workgroup_size_y(this.handle));
    }

    // Z 次元値（未指定時は 1）。
    public workgroupSizeZ(): u32 {
        return new u32(__builtin_gpu_kernel_workgroup_size_z(this.handle));
    }
}


// ============================================================
//  § 8.3.2  GpuArgs
//    gpuDispatch() に渡す引数束。
//    型付きビルダーで gpu 関数の引数列を順に格納する。
//    引数の順序・型は宣言時のカーネル関数シグネチャと一致させること。
// ============================================================
public class GpuArgs {
    mocp public let handle: _m64;

    public constructor() {
        this.handle = __builtin_gpu_args_create();
    }

    // 仕様 §8.3.2: 読み取り専用バッファ参照を引数として追加（Ptr<T> 引数に対応）。
    // 実 GPU バックエンドでは WGSL の `var<storage, read>` / MSL の
    // `device const T*` にマップされる。CPU エミュレーションでは差異なし。
    public pushBuffer(buf: &GpuBuffer): void {
        __builtin_gpu_args_push_buffer(this.handle, buf.handle);
    }

    // 仕様 §8.3.2: 書き込み用バッファ参照を引数として追加（Ptr<T> 引数に対応）。
    // 実 GPU バックエンドでは WGSL の `var<storage, read_write>` / MSL の
    // `device T*` にマップされる。CPU エミュレーションでは差異なし。
    public pushBufferMut(buf: &mut GpuBuffer): void {
        __builtin_gpu_args_push_buffer(this.handle, buf.handle);
    }

    public pushI32(v: i32): void {
        __builtin_gpu_args_push_i32(this.handle, v.bits);
    }

    public pushU32(v: u32): void {
        __builtin_gpu_args_push_u32(this.handle, v.bits);
    }

    public pushI64(v: i64): void {
        __builtin_gpu_args_push_i64(this.handle, v.bits);
    }

    public pushU64(v: u64): void {
        __builtin_gpu_args_push_u64(this.handle, v.bits);
    }

    public pushF32(v: f32): void {
        __builtin_gpu_args_push_f32(this.handle, v.bits);
    }

    public pushF64(v: f64): void {
        __builtin_gpu_args_push_f64(this.handle, v.bits);
    }

    public pushBoolean(v: boolean): void {
        __builtin_gpu_args_push_boolean(this.handle, v.bits);
    }

    // 現在登録されている引数数を返す。
    public count(): u32 {
        return new u32(__builtin_gpu_args_count(this.handle));
    }

    // 内部バッファを空にする（再利用用）。
    public clear(): void {
        __builtin_gpu_args_clear(this.handle);
    }
}


// ============================================================
//  § 8.3.3  ディスパッチ関数
// ============================================================

// 指定カーネルを gridX × gridY × gridZ 個のワークグループでディスパッチ。
// 実際の起動スレッド総数は grid × workgroupSize 個。
// 本関数は非同期: 戻った時点で完了は保証されない（§8.3.4）。
public function gpuDispatch(
    kernel: GpuKernel,
    args: GpuArgs,
    gridX: u32,
    gridY: u32,
    gridZ: u32
): void {
    __builtin_gpu_dispatch(
        kernel.handle, args.handle,
        gridX.bits, gridY.bits, gridZ.bits
    );
}

// gpuDispatch(kernel, args, gridX, 1, 1) のシンタックスシュガー。
public function gpuDispatch1D(
    kernel: GpuKernel,
    args: GpuArgs,
    gridX: u32
): void {
    __builtin_gpu_dispatch(
        kernel.handle, args.handle,
        gridX.bits, new u32(1).bits, new u32(1).bits
    );
}

// キューに積まれた全 GPU ディスパッチの完了を待機する。
// CPU から GPU 結果バッファを mapRead() する前に必ず呼ぶこと。
public function gpuSync(): void {
    __builtin_gpu_sync();
}

// 未送出のディスパッチを GPU に送信するが、完了は待たない。
public function gpuFlush(): void {
    __builtin_gpu_flush();
}
