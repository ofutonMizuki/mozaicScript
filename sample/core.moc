// ============================================================
//  core.moc — mozaicScript コアライブラリ
//
//  【ファイル種別】§2
//    .moc ファイルはコンパイラ特権モードで処理される。
//    _m8 / _m16 / _m32 / _m64 / _m128 / _m256 / _m512 および
//    __builtin_* 命令はここでのみ使用可能。
//
//  【リテラル規則】§5.1 / §6.4
//    数値・真偽値・文字リテラルは .moc 内の
//    クラスコンストラクタ引数位置にのみ記述できる。
//    コンパイラは自動的に対応する _mN へ内部変換する。
//
//  【純粋OOP】§6.2
//    i32 / u32 / f32 などの基本型はコンパイラ組み込みではなく、
//    すべてこのファイルで通常のクラスとして実装する。
// ============================================================

// ------------------------------------------------------------
// § 3.1  ビット系列プリミティブ利用例（サイズ確認コメント）
//   _m8   =   8bit  （int8量子化・MLP軽量化）
//   _m16  =  16bit  （fp16 / int16量子化）
//   _m32  =  32bit  （現行32bit CPU）
//   _m64  =  64bit  （現行64bit CPU）
//   _m128 = 128bit  （SIMD / 将来の128bit CPU）
//   _m256 = 256bit  （SIMD / 将来の256bit CPU）
//   _m512 = 512bit  （SIMD / AVX-512）
// ------------------------------------------------------------


// ============================================================
//  § 6.1  アクセス修飾子の使い分け
//    public      : どこからでもアクセス可能・自動エクスポート（§6.3）
//    private     : クラス内部のみ
//    mocp public : .moc ファイル内のみ（.moz からアクセス不可）
// ============================================================


// ============================================================
//  boolean
// ============================================================
public class boolean {
    // mocp public: .moz からは直接 .bits にアクセス不可
    mocp public let bits: _m32;

    // § 6.1  コンストラクタのアクセス修飾子は public のみ
    // § 6.4  リテラルは .moc コンストラクタ引数のみ可
    public constructor(value: _m32) {
        this.bits = value;
    }

    // § 6.5  演算子オーバーロード
    public operator==(other: boolean): boolean {
        return new boolean(__builtin_i32_eq(this.bits, other.bits));
    }

    public operator&&(other: boolean): boolean {
        return new boolean(__builtin_i32_and(this.bits, other.bits));
    }

    public operator||(other: boolean): boolean {
        return new boolean(__builtin_i32_or(this.bits, other.bits));
    }

    // § 6.5  !a → a.operatorNot()
    // __builtin_i32_eq(bits, 0) → bits が 0 なら 1、非0 なら 0（論理 NOT）
    public operatorNot(): boolean {
        return new boolean(__builtin_i32_eq(this.bits, __builtin_zeroinit()));
    }
}


// ============================================================
//  MemoryOrder — アトミック操作のメモリ順序制約
//  内部値: 0=Relaxed, 1=Acquire, 2=Release, 3=AcqRel, 4=SeqCst
// ============================================================
public class MemoryOrder {
    mocp public let bits: _m32;

    public constructor(value: _m32) {
        this.bits = value;
    }

    public operator==(other: MemoryOrder): boolean {
        return new boolean(__builtin_i32_eq(this.bits, other.bits));
    }
}

public function memoryOrderRelaxed(): MemoryOrder { return new MemoryOrder(0); }
public function memoryOrderAcquire(): MemoryOrder { return new MemoryOrder(1); }
public function memoryOrderRelease(): MemoryOrder { return new MemoryOrder(2); }
public function memoryOrderAcqRel():  MemoryOrder { return new MemoryOrder(3); }
public function memoryOrderSeqCst():  MemoryOrder { return new MemoryOrder(4); }


// ============================================================
//  i32 — 符号あり 32bit 整数
// ============================================================
public class i32 {
    mocp public let bits: _m32;

    public constructor(value: _m32) {
        this.bits = value;
    }

    // § 9.1  数値演算命令
    public operator+(other: i32): i32 {
        return new i32(__builtin_i32_add(this.bits, other.bits));
    }
    public operator-(other: i32): i32 {
        return new i32(__builtin_i32_sub(this.bits, other.bits));
    }
    public operator*(other: i32): i32 {
        return new i32(__builtin_i32_mul(this.bits, other.bits));
    }
    public operator/(other: i32): i32 {
        return new i32(__builtin_i32_div(this.bits, other.bits));
    }
    public operator%(other: i32): i32 {
        return new i32(__builtin_i32_mod(this.bits, other.bits));
    }

    // 比較（戻り値は boolean）
    public operator==(other: i32): boolean {
        return new boolean(__builtin_i32_eq(this.bits, other.bits));
    }
    public operator<(other: i32): boolean {
        return new boolean(__builtin_i32_lt(this.bits, other.bits));
    }
    public operator>(other: i32): boolean {
        return new boolean(__builtin_i32_gt(this.bits, other.bits));
    }

    // § 9.5  単項演算
    public negate(): i32 {
        return new i32(__builtin_i32_neg(this.bits));
    }

    // § 9.8  ビット操作命令
    public clz(): i32 {
        return new i32(__builtin_i32_clz(this.bits));
    }
    public ctz(): i32 {
        return new i32(__builtin_i32_ctz(this.bits));
    }
    public popcnt(): i32 {
        return new i32(__builtin_i32_popcnt(this.bits));
    }
    public rotl(shift: i32): i32 {
        return new i32(__builtin_i32_rotl(this.bits, shift.bits));
    }
    public rotr(shift: i32): i32 {
        return new i32(__builtin_i32_rotr(this.bits, shift.bits));
    }

    // § 9.2.1  ビットシフト（言語に << >> 演算子はないのでメソッドで提供）
    public shl(shift: i32): i32 {
        return new i32(__builtin_i32_shl(this.bits, shift.bits));
    }
    public shr(shift: i32): i32 {
        return new i32(__builtin_i32_shr(this.bits, shift.bits));
    }

    // § 9.7  型変換命令（暗黙変換禁止 §4.4 → すべて明示メソッド）
    public toU32(): u32 {
        return new u32(__builtin_i32_to_u32(this.bits));
    }
    public toI64(): i64 {
        return new i64(__builtin_i32_to_i64(this.bits));
    }
    public toF32(): f32 {
        return new f32(__builtin_i32_to_f32(this.bits));
    }
    public toF64(): f64 {
        return new f64(__builtin_i32_to_f64(this.bits));
    }
}


// ============================================================
//  u32 — 符号なし 32bit 整数
// ============================================================
