// ============================================================
//  f32 — 32bit 浮動小数点数
// ============================================================
public class f32 {
    mocp public let bits: _m32;

    public constructor(value: _m32) {
        this.bits = value;
    }

    public operator+(other: f32): f32 {
        return new f32(__builtin_f32_add(this.bits, other.bits));
    }
    public operator-(other: f32): f32 {
        return new f32(__builtin_f32_sub(this.bits, other.bits));
    }
    public operator*(other: f32): f32 {
        return new f32(__builtin_f32_mul(this.bits, other.bits));
    }
    public operator/(other: f32): f32 {
        return new f32(__builtin_f32_div(this.bits, other.bits));
    }
    public operator==(other: f32): boolean {
        return new boolean(__builtin_f32_eq(this.bits, other.bits));
    }
    public operator<(other: f32): boolean {
        return new boolean(__builtin_f32_lt(this.bits, other.bits));
    }
    public operator>(other: f32): boolean {
        return new boolean(__builtin_f32_gt(this.bits, other.bits));
    }

    // § 9.5  単項演算
    public negate(): f32 {
        return new f32(__builtin_f32_neg(this.bits));
    }

    // § 9.9  浮動小数点演算命令
    public abs(): f32 {
        return new f32(__builtin_f32_abs(this.bits));
    }
    public sqrt(): f32 {
        return new f32(__builtin_f32_sqrt(this.bits));
    }
    public floor(): f32 {
        return new f32(__builtin_f32_floor(this.bits));
    }
    public ceil(): f32 {
        return new f32(__builtin_f32_ceil(this.bits));
    }
    public trunc(): f32 {
        return new f32(__builtin_f32_trunc(this.bits));
    }
    public nearest(): f32 {
        return new f32(__builtin_f32_nearest(this.bits));
    }
    public min(other: f32): f32 {
        return new f32(__builtin_f32_min(this.bits, other.bits));
    }
    public max(other: f32): f32 {
        return new f32(__builtin_f32_max(this.bits, other.bits));
    }

    // § 9.10  超越関数（予約済み・バックエンド実装依存）
    public sin(): f32 {
        return new f32(__builtin_f32_sin(this.bits));
    }
    public cos(): f32 {
        return new f32(__builtin_f32_cos(this.bits));
    }
    public tan(): f32 {
        return new f32(__builtin_f32_tan(this.bits));
    }
    public exp(): f32 {
        return new f32(__builtin_f32_exp(this.bits));
    }
    public log(): f32 {
        return new f32(__builtin_f32_log(this.bits));
    }
    public pow(exponent: f32): f32 {
        return new f32(__builtin_f32_pow(this.bits, exponent.bits));
    }
    public atan(): f32 {
        return new f32(__builtin_f32_atan(this.bits));
    }
    public atan2(x: f32): f32 {
        return new f32(__builtin_f32_atan2(this.bits, x.bits));
    }

    // § 9.7  型変換
    public toI32(): i32 {
        return new i32(__builtin_f32_to_i32(this.bits));
    }
    public toU32(): u32 {
        return new u32(__builtin_f32_to_u32(this.bits));
    }
    public toF64(): f64 {
        return new f64(__builtin_f32_to_f64(this.bits));
    }
}


