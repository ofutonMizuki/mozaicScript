}


// ============================================================
//  § 4.5  型エイリアス
//  § 4.6  型同一性: char == u32、string == Array<u32>
// ============================================================
type char = u32;


// ============================================================
//  Array<T> — ヒープ上のメモリ配列
//
//  § 3.2  ポインタ表現: _m32（32bit アーキテクチャ想定）
//  § 9.4  メモリ管理命令を使用
//  § 9.6  __builtin_sizeof<T>() で要素サイズを取得
//
//  ※ operator[] / operator_set[] は T が _m32 単一フィールド
//     クラス（i32, u32, f32 など）であることを前提とする。
//     T が複合型の場合はバックエンドによる拡張が必要。
// ============================================================
public class Array<T> {
    private let ptr: _m32;    // § 3.2  ヒープポインタ（32bit）
    public let length: u32;   // 要素数（公開フィールド）

    public constructor(size: u32) {
        this.length = size;
        // § 9.4  malloc: sizeof<T> バイト × size 個の領域を確保
        this.ptr = __builtin_malloc(
            __builtin_u32_mul(this.length.bits, __builtin_sizeof<T>())
        );
    }

    // § 6.5  a[i] → operator[](index)
    public operator[](index: u32): T {
        const offset: _m32 = __builtin_u32_mul(index.bits, __builtin_sizeof<T>());
        const raw: _m32 = __builtin_mem_read32(this.ptr, offset);
        return new T(raw);
    }

    // § 6.5  a[i] = v → operator_set[](index, value)
    public operator_set[](index: u32, value: T): void {
        const offset: _m32 = __builtin_u32_mul(index.bits, __builtin_sizeof<T>());
        __builtin_mem_write32(this.ptr, offset, value.bits);
    }

    // § 9.4  ヒープ解放
    public free(): void {
        __builtin_free(this.ptr);
    }
}

// § 4.5 / § 4.6  string == Array<u32> == Array<char>
type string = Array<u32>;


// ============================================================
//  Option<T> — 値の有無を表す型（§ 8）
//  例外を使わず、値の欠如を型で表現する。
//
//  コンストラクタ: new Option<T>(present, val)
//    present = TRUE  → Some(val)
//    present = FALSE → None（val は無視、ダミー値を渡す）
// ============================================================
public class Option<T> {
    private let hasValue: boolean;
    private let value: T;

    public constructor(present: boolean, val: T) {
        this.hasValue = present;
        this.value = val;
    }

    public isSome(): boolean {
        return this.hasValue;
    }

    // § 6.5  !a → a.operatorNot() に脱糖
    public isNone(): boolean {
        return !this.hasValue;
    }

    public unwrap(): T {
        // § 5.4  if の脱糖: __builtin_if(cond)
        if (this.hasValue == new boolean(1)) {
            return this.value;
        }
        // § 9.3  panic: 即時強制終了
        __builtin_panic("Option::unwrap() called on None");
        return this.value;   // 到達不能（コンパイラの戻り値要求を満たすため）
    }
}


// ============================================================
//  Result<T> — 成功または失敗を表す型（§ 8）
//  try / catch / throw は仕様上存在しない（MUST NOT）。
//
//  コンストラクタ: new Result<T>(success, val, errMsg)
//    success = TRUE  → Ok(val)   （errMsg は空文字列 ""）
//    success = FALSE → Err(msg)  （val はダミー値）
// ============================================================
public class Result<T> {
    private let ok: boolean;
    private let value: T;
    private let errMsg: string;

    public constructor(success: boolean, val: T, err: string) {
        this.ok = success;
        this.value = val;
        this.errMsg = err;
    }

    public isOk(): boolean {
        return this.ok;
    }

    public isErr(): boolean {
        return !this.ok;
    }

    public unwrap(): T {
        if (this.ok == new boolean(1)) {
            return this.value;
        }
        __builtin_panic("Result::unwrap() called on Err");
        return this.value;
    }

    public unwrapErr(): string {
        if (this.ok == new boolean(0)) {
            return this.errMsg;
        }
        __builtin_panic("Result::unwrapErr() called on Ok");
        return this.errMsg;
    }
}


// ============================================================
//  Ptr<T> — 型付きポインタ（§ 5.11）
//
//  コンストラクタは _m32 を受け取るため .moc 専用。
//  .moz コードはライブラリが返す Ptr<T> を受け取って使用する。
//  T は単一の _m32 / _m64 フィールドを持つクラスのみ対応。
// ============================================================
public class Ptr<T> {
    mocp public let addr: _m32;

    public constructor(rawAddr: _m32) {
        this.addr = rawAddr;
    }

    public deref(): T {
        const raw: _m32 = __builtin_mem_read32(this.addr, __builtin_zeroinit());
        return new T(raw);
    }

    public write(val: T): void {
        __builtin_mem_write32(this.addr, __builtin_zeroinit(), val.bits);
    }

    public isNull(): boolean {
        return new boolean(__builtin_i32_eq(this.addr, __builtin_zeroinit()));
    }

    public free(): void {
        __builtin_free(this.addr);
    }

    // § 14.3.1: gpu カーネル内で ptr[i] 形式の要素アクセスを行う。
    // T は単一 _m32 フィールドのラッパー型 (i32/u32/f32) 限定。
    public operator[](index: u32): T {
        const offset: _m32 = __builtin_u32_mul(index.bits, __builtin_sizeof<T>());
        const raw: _m32 = __builtin_mem_read32(this.addr, offset);
        return new T(raw);
    }

    public operator_set[](index: u32, value: T): void {
        const offset: _m32 = __builtin_u32_mul(index.bits, __builtin_sizeof<T>());
        __builtin_mem_write32(this.addr, offset, value.bits);
    }
}


// ============================================================
//  Stdout / Stderr / Stdin — 標準入出力クラス（§ 5.12, § 5.13）
// ============================================================
public class Stdout {
    mocp public let handle: _m32;

    public constructor(h: _m32) {
        this.handle = h;
    }

    public write(s: string): void {
        __builtin_stdout_write(s);
    }

    public writeLine(s: string): void {
        __builtin_stdout_write(s);
        let nl: string = "\n";
        __builtin_stdout_write(nl);
    }
}

public class Stderr {
    mocp public let handle: _m32;

    public constructor(h: _m32) {
        this.handle = h;
    }

    public write(s: string): void {
        __builtin_stderr_write(s);
    }

    public writeLine(s: string): void {
        __builtin_stderr_write(s);
        let nl: string = "\n";
        __builtin_stderr_write(nl);
    }
}

public class Stdin {
    mocp public let handle: _m32;

    public constructor(h: _m32) {
        this.handle = h;
    }

    public readLine(): string {
        return __builtin_stdin_readline();
    }
}

// ============================================================
//  § 9.12  標準 I/O ラッパー（.moz から呼び出し可能）
// ============================================================
public function print(s: string): void {
    __builtin_stdout_write(s);
}

public function eprint(s: string): void {
    __builtin_stderr_write(s);
}

public function readLine(): string {
    return __builtin_stdin_readline();
}

// § 9.3  パニックラッパー
public function panic(msg: string): void {
    __builtin_panic(msg);
}


// ============================================================
//  § 9.11  マルチスレッドラッパー（§ 13）
//
//  mozaicScript のスレッドコードは
//  プリエンプティブなマルチスレッド環境を前提に記述する（MUST）。
//  プリエンプティブ / コオペラティブの違いを前提としたコードは禁止（MUST NOT）。
// ============================================================

// スレッド生成・待機
public function threadSpawn(fnName: string): u64 {
    // args は空配列（簡略版）— 実引数を渡す場合は Array<_m32> を構築して渡す
    let emptyArgs: Array<_m32> = new Array<_m32>(new u32(0));
    return new u64(__builtin_thread_spawn(fnName, emptyArgs));
}

public function threadJoin(id: u64): void {
    __builtin_thread_join(id.bits);
}

// スレッドプール
public function threadpoolCreate(size: u32): u64 {
    return new u64(__builtin_threadpool_create(size.bits));
}
public function threadpoolSubmit(pool: u64, fnName: string): void {
    let emptyArgs: Array<_m32> = new Array<_m32>(new u32(0));
    __builtin_threadpool_submit(pool.bits, fnName, emptyArgs);
}
public function threadpoolWait(pool: u64): void {
    __builtin_threadpool_wait(pool.bits);
}
public function threadpoolDestroy(pool: u64): void {
    __builtin_threadpool_destroy(pool.bits);
}

// ミューテックス
public function mutexCreate(): u64 {
    return new u64(__builtin_mutex_create());
}
public function mutexLock(m: u64): void {
    __builtin_mutex_lock(m.bits);
}
public function mutexUnlock(m: u64): void {
    __builtin_mutex_unlock(m.bits);
}

// 条件変数
public function condvarCreate(): u64 {
    return new u64(__builtin_condvar_create());
}
public function condvarWait(cv: u64, mutex: u64): void {
    __builtin_condvar_wait(cv.bits, mutex.bits);
}
public function condvarSignal(cv: u64): void {
    __builtin_condvar_signal(cv.bits);
}
public function condvarBroadcast(cv: u64): void {
    __builtin_condvar_broadcast(cv.bits);
}

// ============================================================
//  § 6.6 / 6.7  アトミック操作 — MemoryOrder 対応版
// ============================================================

// 32bit
public function atomicLoad32(ptr: u32, order: MemoryOrder): u32 {
    return new u32(__builtin_atomic_load32(ptr.bits, order.bits));
}
public function atomicStore32(ptr: u32, val: u32, order: MemoryOrder): void {
    __builtin_atomic_store32(ptr.bits, val.bits, order.bits);
}
public function atomicCas32(ptr: u32, expected: u32, desired: u32, successOrder: MemoryOrder, failureOrder: MemoryOrder): boolean {
    return new boolean(__builtin_atomic_cas32(ptr.bits, expected.bits, desired.bits, successOrder.bits, failureOrder.bits));
}
public function atomicFetchAdd32(ptr: u32, val: u32, order: MemoryOrder): u32 {
    return new u32(__builtin_atomic_fetch_add32(ptr.bits, val.bits, order.bits));
}
public function atomicFetchSub32(ptr: u32, val: u32, order: MemoryOrder): u32 {
    return new u32(__builtin_atomic_fetch_sub32(ptr.bits, val.bits, order.bits));
}

// 64bit
public function atomicLoad64(ptr: u32, order: MemoryOrder): u64 {
    return new u64(__builtin_atomic_load64(ptr.bits, order.bits));
}
public function atomicStore64(ptr: u32, val: u64, order: MemoryOrder): void {
    __builtin_atomic_store64(ptr.bits, val.bits, order.bits);
}
public function atomicCas64(ptr: u32, expected: u64, desired: u64, successOrder: MemoryOrder, failureOrder: MemoryOrder): boolean {
    return new boolean(__builtin_atomic_cas64(ptr.bits, expected.bits, desired.bits, successOrder.bits, failureOrder.bits));
}
public function atomicFetchAdd64(ptr: u32, val: u64, order: MemoryOrder): u64 {
    return new u64(__builtin_atomic_fetch_add64(ptr.bits, val.bits, order.bits));
}
public function atomicFetchSub64(ptr: u32, val: u64, order: MemoryOrder): u64 {
    return new u64(__builtin_atomic_fetch_sub64(ptr.bits, val.bits, order.bits));
}

// フェンス
public function atomicFence(order: MemoryOrder): void {
    __builtin_atomic_fence(order.bits);
}

// アトミック操作用メモリ確保（ワードインデックスを返す）
public function allocWord(): u32 {
    return new u32(__builtin_malloc(new u32(4).bits));
}
public function allocDword(): u32 {
    return new u32(__builtin_malloc(new u32(8).bits));
}


// ============================================================
//  § 9.6  sizeof デモ（コメント）
//
//  __builtin_sizeof<i32>() → 4  （_m32 = 4バイト）
//  __builtin_sizeof<i64>() → 8  （_m64 = 8バイト）
//  __builtin_sizeof<f32>() → 4
// ============================================================
