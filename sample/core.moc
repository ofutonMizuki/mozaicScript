        return new u32(__builtin_u32_shl(this.bits, shift.bits));
    }
    public shr(shift: u32): u32 {
        return new u32(__builtin_u32_shr(this.bits, shift.bits));
    }

    // § 9.7  型変換
    public toI32(): i32 {
        return new i32(__builtin_u32_to_i32(this.bits));
    }
    public toU64(): u64 {
        return new u64(__builtin_u32_to_u64(this.bits));
    }
    public toF32(): f32 {
        return new f32(__builtin_u32_to_f32(this.bits));
    }
    public toF64(): f64 {
        return new f64(__builtin_u32_to_f64(this.bits));
    }
}


