        return new u32(__builtin_u32_div(this.bits, other.bits));
    }
    public operator%(other: u32): u32 {
        return new u32(__builtin_u32_mod(this.bits, other.bits));
    }
    public operator==(other: u32): boolean {
        return new boolean(__builtin_u32_eq(this.bits, other.bits));
    }
    public operator<(other: u32): boolean {
        return new boolean(__builtin_u32_lt(this.bits, other.bits));
    }
    public operator>(other: u32): boolean {
        return new boolean(__builtin_u32_gt(this.bits, other.bits));
    }

    // § 9.2.1
